# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is git-ignored and is read automatically by docker compose.
# ---------------------------------------------------------------------------

# Required. One or more sitemap URLs, separated by commas.
#
#   Single site:
#     SITEMAP_LINK=https://example.com/sitemap.xml
#
#   Multiple sites (the daily quota is shared across all of them):
#     SITEMAP_LINK=https://example.com/sitemap.xml,https://other.com/sitemap.xml
#
#   Pair a sitemap with a specific Search Console property using "|" when the
#   site is registered as a URL-prefix property instead of a domain property:
#     SITEMAP_LINK=https://example.com/sitemap.xml|https://example.com/shop/
SITEMAP_LINK=https://foobar.com/sitemap.xml

# Required. Service account email, added as an Owner in Search Console.
SERVICE_CLIENT_EMAIL=foobar@decent-surf-420609.iam.gserviceaccount.com

# Required. Base64 of the service account's private_key field.
#   Linux/macOS: printf '%s' "$(jq -r .private_key key.json)" | base64 -w0
#   PowerShell:  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content key.json | ConvertFrom-Json).private_key))
PRIVATE_KEY_BTOA=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1JSUV2UUlCQURBTk...

# Optional. Search Console property override for a SINGLE sitemap only.
# Leave unset to derive "sc-domain:<hostname>" automatically.
# SITE_URL=https://foobar.com/

# Optional. Google's documented daily quota is 200 URLs per project.
# DAILY_LIMIT=200

# Optional. Seconds to wait between submissions.
# REQUEST_DELAY_SECONDS=15

# Optional. Hours between passes. Slightly over 24 to avoid quota-window drift.
# INTERVAL_HOURS=25

# Optional. Run a single pass and exit instead of looping forever.
# RUN_ONCE=false

# Optional. Verbose logging.
# DEBUG=false
